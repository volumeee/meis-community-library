{
  "name": "meis-community-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx backend/src/index.ts",
    "start": "NODE_ENV=production tsx backend/src/index.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "seed": "tsx backend/src/scripts/seed.ts",
    "test": "tsx --test 'backend/src/tests/*.test.ts' 'frontend/src/**/*.test.ts' 'frontend/src/**/*.test.tsx'",
    "clean": "rm -rf frontend/dist dist dist-server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint backend/src frontend/src frontend/vite.config.ts shared",
    "lint:fix": "eslint backend/src frontend/src frontend/vite.config.ts shared --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mongoose": "^9.12.3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prettier": "^3.10.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zustand": "^5.1.0"
  }
}
