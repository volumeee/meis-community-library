# MONGODB_URI: MongoDB Atlas or local MongoDB connection string with replica-set
# transaction support (e.g. mongodb://127.0.0.1:27017/meis_community_library?replicaSet=rs0).
# MongoDB is required for authenticated use. Never commit real credentials.
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster-host>/meis_community_library?retryWrites=true&w=majority"

# Optional database name override used only when MONGODB_URI omits a database path
# (defaults to "meis_community_library").
# MONGODB_DB_NAME=meis_community_library

# Server listening port (defaults to 3000 locally; 4000 in Docker Compose).
PORT=3000

# Set to "true" to run Express in API-only mode (used behind Nginx in Docker).
# API_ONLY=true

# Required in production: at least 32 bytes/characters, kept stable across restarts and replicas.
JWT_SECRET=

# Required in production while creating the first administrator via POST /api/auth/setup
# (at least 32 characters). Remove from the environment after initial setup succeeds.
# SETUP_TOKEN=

# Explicit reverse-proxy IP(s) or CIDR(s) trusted for X-Forwarded-For / X-Forwarded-Proto
# (comma-separated, e.g. 172.29.46.10). Set automatically in docker-compose.yml.
# TRUST_PROXY=172.29.46.10

# Cloudflare Tunnel token used by the tunnel service in docker-compose.yml.
TUNNEL_TOKEN=

# Optional Docker Compose internal backend network customization (must stay in sync).
# BACKEND_SUBNET=172.29.46.0/24
# FRONTEND_BACKEND_IP=172.29.46.10

# Optional environment-based librarian override (alternative to /api/auth/setup).
# When LIBRARIAN_PASSWORD (>= 8 characters) is set, login authenticates against these
# variables and in-app password changes are disabled.
# LIBRARIAN_EMAIL=mei@communitylibrary.org
# LIBRARIAN_NAME="Mei Lin"
# LIBRARIAN_PASSWORD=
